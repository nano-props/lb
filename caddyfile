ada.nano-props.asia {
        @bypass path /ws/*
        handle @bypass {
                reverse_proxy 127.0.0.1:32100
        }
        handle {
                reverse_proxy 127.0.0.1:32100
        }
}

herta.nano-props.asia {
        @bypass path /ws/*
